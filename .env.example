# PostgreSQL 18 + pgvector (database e usuário exclusivos deste serviço)
POSTGRES_URL=postgresql://vse:vse@127.0.0.1:5435/vse

# Cache (opcional: fora do ar, as rotas só ficam mais lentas)
REDIS_URL=redis://127.0.0.1:6380/0

# RabbitMQ. No compose do gateway: amqp://guest:guest@simila-rabbitmq:5672
AMQP_URL=amqp://guest:guest@127.0.0.1:5672

# JWT do Auth. Na rede do gateway: http://simila-auth:3000/api/auth/jwks
AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
# "iss" do JWT (BETTER_AUTH_URL do Auth). Produção: https://simila.fslab.dev
AUTH_ISSUER=http://localhost:3000
# Intervalo mínimo, em segundos, entre buscas do JWKS por kid desconhecido
AUTH_JWKS_COOLDOWN=30
# Origens extras aceitas pelo CORS, separadas por vírgula
CORS_ORIGINS=

# Base pública do bucket do simila-imagens (thumbnails), no Garage do fslab
MEDIA_BASE_URL=https://simila.web.fslab.dev

# Modelo CLIP (os pesos são baixados para ~/.cache/clip na primeira execução, ~340 MB)
CLIP_MODELO=ViT-B/32
# Threads do torch (0 = padrão, número de CPUs)
TORCH_THREADS=0

# Lote de inferência do worker: até LOTE_MAX imagens ou LOTE_ESPERA_MS, o que vier primeiro
LOTE_MAX=16
LOTE_ESPERA_MS=200

# Busca: precisão do HNSW (maior = mais preciso e mais lento) e TTL do cache, em segundos
HNSW_EF_SEARCH=64
CACHE_TTL_SIMILARES=300
CACHE_TTL_TEXTO=86400

# Faixa de k testada pela silhueta no k-means
K_MIN=2
K_MAX=30
